# ============================================================
# 系统配置模板：复制为 .env 后按需修改
#   Windows:  copy .env.example .env
# ============================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000

# ---------- 认证密钥（生产环境务必修改） ----------
JWT_SECRET=please-change-this-secret-key
JWT_EXPIRE_HOURS=72

# ---------- 大模型接入（二选一或按需切换） ----------
# 可选值：ollama（本地） / openai（OpenAI 兼容 API）
LLM_PROVIDER=ollama

# --- Ollama 本地模式 ---
# 需先安装 Ollama：https://ollama.com
# 拉取模型示例：
#   ollama pull qwen2.5:7b          # 对话模型
#   ollama pull bge-m3              # 向量模型（中文效果好）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TEMPERATURE=0.3

# --- OpenAI 兼容 API 模式（如 DeepSeek / 通义 / Moonshot 等） ---
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_LLM_MODEL=deepseek-chat
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.3

# 向量化模型来源：默认跟随 LLM_PROVIDER，也可单独指定 ollama / openai
EMBEDDING_PROVIDER=

# ---------- RAG 参数 ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
COLLECTION_NAME=course_knowledge

# 大模型单次回答超时（秒），超过即停止生成并提示，防止回答卡死
LLM_TIMEOUT=180
