# ============================================================
# 系统配置模板：复制为 .env 后按需修改
#   Windows:  copy .env.example .env
# ============================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000

# ---------- 认证密钥（生产环境务必修改） ----------
JWT_SECRET=please-change-this-secret-key
JWT_EXPIRE_HOURS=72

# ---------- 大模型接入（二选一或按需切换） ----------
# 可选值：ollama（本地） / openai（OpenAI 兼容 API）
LLM_PROVIDER=ollama

# --- Ollama 本地模式 ---
# 需先安装 Ollama：https://ollama.com
# 拉取模型示例：
#   ollama pull qwen2.5:3b          # 对话模型
#   ollama pull bge-m3              # 向量模型（中文效果好）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TEMPERATURE=0.3

# --- OpenAI 兼容 API 模式（如 DeepSeek / 通义 / Moonshot 等） ---
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_LLM_MODEL=deepseek-chat
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.3

# 向量化模型来源：默认跟随 LLM_PROVIDER，也可单独指定 ollama / openai
EMBEDDING_PROVIDER=

# ---------- RAG 参数 ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
# 知识库无匹配判定阈值（L2 距离）：检索最相似资料的距离超过该值即判定"知识库未收录"。
# 实测：库内有答案 0.46~0.78 / 库无但话题沾边 0.91~1.05 / 完全无关 1.19~1.21，取 0.85。
UNMATCHED_DISTANCE=0.85

# 二次可答性判定：命中检索后再判一次"资料里是否直接讲了这个问题"，否就拒答。
# 用来挡"资料讲二叉树、学生问红黑树"式的编造。
# 注意：实测 qwen2.5:3b 做不了这个判定（6 种提示词写法都是恒定答案或漏判），
# 因此默认关闭。判定模型换成 7B 以上再打开。
ANSWERABILITY_CHECK=false
COLLECTION_NAME=course_knowledge

# 大模型单次回答超时（秒），超过即停止生成并提示，防止回答卡死
LLM_TIMEOUT=180
