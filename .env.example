# ============================================================
# 系统配置模板：复制为 .env 后按需修改
#   Windows:  copy .env.example .env
# ============================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000

# ---------- 认证密钥（生产环境务必修改） ----------
JWT_SECRET=please-change-this-secret-key
JWT_EXPIRE_HOURS=24
# 首次创建默认管理员时使用的密码；默认 111111，公网部署前务必改成强密码。
# 只在管理员账号不存在时生效，已存在账号请在「个人中心」修改。
DEFAULT_ADMIN_PASSWORD=111111

# ---------- 大模型接入（二选一或按需切换） ----------
# 可选值：ollama（本地） / openai（OpenAI 兼容 API）
LLM_PROVIDER=ollama

# --- Ollama 本地模式 ---
# 需先安装 Ollama：https://ollama.com
# 拉取模型示例：
#   ollama pull qwen3:8b            # 对话模型
#   ollama pull bge-m3              # 向量模型（中文效果好）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TEMPERATURE=0.3

# --- OpenAI 兼容 API 模式（如 DeepSeek / 通义 / Moonshot 等） ---
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_LLM_MODEL=deepseek-chat
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.3

# 向量化模型来源：默认跟随 LLM_PROVIDER，也可单独指定 ollama / openai
EMBEDDING_PROVIDER=

# ---------- RAG 参数 ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
# 知识库无匹配判定阈值（余弦相似度）：最相似资料相似度低于该值即判定"知识库未收录"，越大越严格。
# 40 条标注集实测：0.40 会放行全部无关问题；0.56 拒答 9/10、误拒 2/30；
# 0.58 拒答 10/10、误拒 2/30。默认取 0.56，换 embedding 模型后需重新标定。
# 详细曲线见 docs/evaluation.md。
UNMATCHED_SIMILARITY=0.56

# 二次可答性判定：命中检索后再判一次"资料里是否直接讲了这个问题"，否就拒答。
# 用来挡"资料讲二叉树、学生问红黑树"式的编造。
# 判定模型建议用 7B 以上（如 qwen3:8b），小模型漏判较多。
ANSWERABILITY_CHECK=true
COLLECTION_NAME=course_knowledge

# 大模型单次回答超时（秒），超过即停止生成并提示，防止回答卡死
LLM_TIMEOUT=180

# 上下文窗口（token，prompt+输出共用）与最大输出 token。
# 超窗防护按 token 预算自动裁剪历史与检索资料，避免 Ollama 从头截断丢掉系统规则。
LLM_CTX=8192
LLM_MAX_TOKENS=1024
